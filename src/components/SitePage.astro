---
import { site, type Locale } from "../config/site";
import { routes, type RouteKey } from "../config/routes";
import { useMessages, useTranslations } from "../i18n/ui";
import { getPageContext } from "../services/index";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileLayout from "../layouts/ProfileLayout.astro";
import ContentList from "./common/ContentList.astro";
import SourcePages from "./common/SourcePages.astro";
import TaxonomyIndex from "./common/TaxonomyIndex.astro";

interface Props {
    locale: Locale;
    route: RouteKey;
}

const { locale, route } = Astro.props;
const t = useTranslations(locale);
const { design: copy, content } = useMessages(locale);
const page = routes[route];
const context = await getPageContext(route, locale);
const description = context.section === "feeds" ? context.description : t(page.description);
---

<BaseLayout title={t(page.title)} description={description} locale={locale} route={route}>
    <header class="page-heading">
        <h1>{route === "profile" ? site.name : t(page.title)}</h1>
        {route === "profile" && <p class="name-alias">{site.secondaryName}</p>}
        {context.section !== "profile" && <p class="page-description">{description}</p>}
    </header>
    {context.taxonomyNavigation.map(({ label, href }, index) => (
        <>{index > 0 && " · "}<a class="text-link" href={href}>{content[label]} →</a></>
    ))}
    {context.section === "taxonomy" && <TaxonomyIndex locale={locale} {...context.taxonomy} />}
    {context.section === "profile" && (
        <ProfileLayout locale={locale} route={route} navigation={context.navigation}>
            {context.items.length > 0 ? <ContentList locale={locale} items={context.items} placement={route} /> : (
                <dl class="profile-fields">
                    {context.fields.map((heading) => (
                        <div>
                            <dt>{t(heading)}</dt>
                            <dd>{copy.unpublished}</dd>
                        </div>
                    ))}
                </dl>
            )}
        </ProfileLayout>
    )}
    {context.section === "content" && (
        <>
            {context.items.length > 0 ? (
                <ContentList locale={locale} items={context.items} placement={route} />
            ) : <p class="empty-message">{"empty" in page ? t(page.empty) : copy.unpublished}</p>}
            {context.defaultLanguagePath && (
                <a class="text-link" href={context.defaultLanguagePath}>{content.defaultLanguagePosts} →</a>
            )}
        </>
    )}
    {(context.section === "feeds" || context.section === "projects") && (
        <>
            {context.items.length > 0 && <ContentList locale={locale} items={context.items} placement={route} />}
            <SourcePages locale={locale} section={context.section} label={t(page.title)} sources={context.sources} />
        </>
    )}
</BaseLayout>
