---
import { languages, site, type Locale } from "../../config/site";
import { useTranslations } from "../../i18n/ui";

interface Props {
    locale: Locale;
    languagePaths: Partial<Record<Locale, string>>;
}

const { locale, languagePaths: paths } = Astro.props;
const t = useTranslations(locale);
---

<nav class="language-switcher" aria-label={t("language.label")}>
    <ul>
        {site.locales.map((language) => (
            <li>
                {language === locale ? (
                    <span lang={languages[language].htmlLang} aria-current="page" title={languages[language].name}>
                        {languages[language].shortName}
                    </span>
                ) : paths[language] ? (
                    <a href={paths[language]} lang={languages[language].htmlLang} hreflang={languages[language].htmlLang} aria-label={languages[language].name}>
                        {languages[language].shortName}
                    </a>
                ) : (
                    <span aria-disabled="true" title={t("language.unpublished")}>
                        {languages[language].shortName}
                    </span>
                )}
            </li>
        ))}
    </ul>
</nav>

<style>
    .language-switcher ul {
        display: flex;
        gap: 0.3rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .language-switcher a, .language-switcher span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        min-width: 44px;
        padding: 0.3rem 0.6rem;
        text-decoration: none;
        font-size: 0.75rem;
    }

    .language-switcher [aria-current="page"] {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: .45em;
    }
</style>
