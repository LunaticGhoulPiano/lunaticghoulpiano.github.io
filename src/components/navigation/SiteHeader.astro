---
import { useMessages, useTranslations } from "../../i18n/ui";
import { site, type Locale } from "../../config/site";
import { routes, type RouteKey } from "../../config/routes";
import { getRoutePath } from "../../routing";
import ControlCenter from "../shell/ControlCenter.astro";
import Icon from "../common/Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
    locale: Locale;
    route?: RouteKey;
    languagePaths: Partial<Record<Locale, string>>;
}

const { locale, route, languagePaths } = Astro.props;
const { shell: copy, search } = useMessages(locale);
const t = useTranslations(locale);
---
<header class="site-header" id="top">
    <div class="header-inner">
        <a class="brand" href={getRoutePath("profile", locale)}>{site.brand}</a>
        <span class="workspace-label"><span class="workspace-dot" aria-hidden="true"></span>{route ? t(routes[route].title) : copy.desktop}</span>
        <div class="header-tools">
            <form class="global-search search-field" role="search" method="get" action={getRoutePath("search", locale)} data-global-search data-locale={locale}>
                <label class="sr-only" for="global-search">{search.label}</label>
                <Icon name="search" />
                <input id="global-search" name="q" type="search" placeholder={search.placeholder} autocomplete="off" />
            </form>
            <button class="icon-button filter-trigger" type="button" data-panel-open="filters" aria-label={copy.filters} title={copy.filters} hidden>{copy.filters}</button>
            <button class="control-trigger" type="button" data-panel-open="controls" aria-label={copy.controls} hidden><Icon name="controls" /><span>{copy.controls}</span></button>
            <noscript><LanguageSwitcher locale={locale} languagePaths={languagePaths} /></noscript>
        </div>
    </div>
</header>
<ControlCenter locale={locale} languagePaths={languagePaths} />
