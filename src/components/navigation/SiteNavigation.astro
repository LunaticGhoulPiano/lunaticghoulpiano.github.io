---
import type { Locale } from "../../config/site";
import { mainNavigation } from "../../config/navigation";
import { routes, type RouteKey } from "../../config/routes";
import { getRoutePath, isSectionActive } from "../../routing";
import { useTranslations } from "../../i18n/ui";
import Icon from "../common/Icon.astro";
interface Props { locale: Locale; route?: RouteKey; }
const { locale, route } = Astro.props;
const t = useTranslations(locale);
---
<nav class="site-nav" aria-label={t("nav.main")}>
    <ul class="dock-items">
        {mainNavigation.map((item) => <li>
            <a href={getRoutePath(item, locale)} class:list={{ "is-active": isSectionActive(route, item) }} aria-label={t(routes[item].title)} aria-current={route === item ? "page" : undefined}>
                <Icon name={item} /><span class="dock-label">{t(routes[item].title)}</span>
            </a>
        </li>)}
    </ul>
</nav>
