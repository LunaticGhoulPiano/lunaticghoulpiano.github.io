---
import { site, type Locale } from "../../config/site";
import { routes } from "../../config/routes";
import { getRoutePath, getSectionRoutes } from "../../routing";
import { useTranslations } from "../../i18n/ui";
import SocialLinks from "../common/SocialLinks.astro";
import Icon from "../common/Icon.astro";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const profileNavigation = getSectionRoutes("profile");
---
<div class="profile-desktop">
    <header class="profile-introduction">
        <h1>{site.name}</h1>
        <p class="name-alias">{site.secondaryName}</p>
        <nav class="profile-actions" aria-label={t("nav.profile")}>
            {profileNavigation.filter((key) => key !== "profile").map((key) => <a href={getRoutePath(key, locale)}>{t(routes[key].title)}<Icon name="arrow" /></a>)}
        </nav>
        <SocialLinks locale={locale} />
    </header>
</div>

<style>
    .profile-desktop {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: calc(100svh - 10rem);
    }

    .profile-introduction {
        padding-top: clamp(5rem, 15vh, 12rem);
    }

    .profile-introduction h1 {
        font-size: clamp(4.5rem, 9vw, 9rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.06em;
    }

    :global(:root[data-preset="piano"]) .profile-introduction h1 {
        font-family: Georgia, "Times New Roman", serif;
    }

    :global(:root[data-preset="aviation"]) .profile-introduction h1 {
        font-weight: 300;
        font-style: normal;
        letter-spacing: -0.055em;
    }

    .profile-introduction .name-alias {
        margin-top: 1rem;
        color: var(--muted);
        font-size: 1rem;
    }

    .profile-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.75rem;
        margin-top: 1.75rem;
    }

    .profile-actions a {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        min-height: 44px;
        font-size: 0.85rem;
        text-decoration: none;
        border-bottom: 1px solid var(--chrome-line);
    }

    .profile-actions :global(.icon) {
        width: 15px;
        height: 15px;
    }

    .profile-actions a:hover {
        color: var(--accent);
    }

    @media (max-width: 48rem) {

        .profile-desktop {
            min-height: 0;
        }

        .profile-introduction {
            padding-top: 18svh;
        }

        .profile-introduction h1 {
            font-size: clamp(3.5rem, 16vw, 6.5rem);
        }

        .profile-introduction .name-alias {
            font-size: 0.85rem;
        }

        .profile-actions {
            gap: 0.25rem 1.25rem;
            margin-top: 1.25rem;
        }

        .profile-actions a {
            font-size: 0.75rem;
        }

    }

    @media print {

        .profile-desktop {
            min-height: 0;
        }

        .profile-introduction {
            padding-top: 0;
        }

        .profile-introduction .name-alias {
            color: #444;
        }

        .profile-actions {
            display: none;
        }

    }
</style>
