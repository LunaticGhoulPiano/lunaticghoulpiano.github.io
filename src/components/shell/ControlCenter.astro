---
import { appearanceOptions, appearanceDefaults } from "../../config/appearance";
import { defaultLocale, type Locale } from "../../config/locales";
import type { RouteKey } from "../../config/routes";
import { getRoutePath } from "../../routing";
import { useMessages } from "../../i18n/ui";
import credits from "../../assets/wallpapers/credits.json";
import LanguageSwitcher from "../navigation/LanguageSwitcher.astro";
import Panel from "../common/Panel.astro";
import Icon from "../common/Icon.astro";
interface Props { locale: Locale; route?: RouteKey; languagePaths: Partial<Record<Locale, string>>; }
const { locale, route, languagePaths } = Astro.props;
const resetLanguagePath = locale === defaultLocale ? undefined
    : languagePaths[defaultLocale] ?? getRoutePath(route ?? "profile", defaultLocale);
const { shell: copy, design } = useMessages(locale);
const previews = import.meta.glob<string>("../../assets/wallpapers/previews/*.jpg", { eager: true, import: "default", query: "?url" });
---
<Panel id="controls" title={copy.controls} locale={locale}>
    <fieldset class="preset-options">
        <legend>{copy.preset}</legend>
        {appearanceOptions.preset.map((preset) => (
            <div class="preset-option">
                <label class="preset-choice" data-wallpaper={preset}>
                    <img src={previews[`../../assets/wallpapers/previews/${preset}.jpg`]} alt="" decoding="async" fetchpriority="low" />
                    <input type="radio" name="appearance-preset" value={preset} data-appearance-setting="preset" checked={preset === appearanceDefaults.preset} />
                    <span>{copy[preset]}</span>
                </label>
                <p class="preset-credit"><a href={credits[`${preset}.webp`].source} target="_blank" rel="noreferrer">© {credits[`${preset}.webp`].photographer} / Unsplash ↗</a></p>
            </div>
        ))}
    </fieldset>
    <div class="control-row" data-glass-rule data-glass="controls">
        <span>{copy.theme}</span>
        <button class="theme-toggle" type="button" data-theme-toggle data-system-label={design.themeSystem} data-dark-label={design.themeDark} data-light-label={design.themeLight} data-system-value={copy.system} data-light-value={copy.light} data-dark-value={copy.dark} aria-label={design.themeSystem} hidden>
            <Icon name="contrast" /><span data-theme-value>{copy.system}</span>
        </button>
    </div>
    <div class="control-row" data-glass-rule><span>{copy.language}</span><LanguageSwitcher locale={locale} languagePaths={languagePaths} /></div>
    <div class="control-footer">
        <button class="text-link" type="button" data-appearance-reset data-reset-language-path={resetLanguagePath}><Icon name="reset" />{copy.reset}</button>
    </div>
</Panel>

<script>
    import { navigate } from "astro:transitions/client";

    document.addEventListener("site:reset", () => {
        const path = document.querySelector<HTMLButtonElement>("[data-reset-language-path]")?.dataset.resetLanguagePath;
        if (!path) return;
        const target = new URL(path, location.href);
        if (target.origin === location.origin) {
            if (!target.search) target.search = location.search;
            if (!target.hash) target.hash = location.hash;
        }
        void navigate(target.href);
    });
</script>

<style>
    .preset-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
        gap: 0.6rem;
        padding: 0 0 1.5rem;
        margin: 0;
        border: 0;
    }

    .preset-options legend {
        padding: 0 0 0.75rem;
        font-size: 0.8rem;
        color: var(--muted);
    }

    .preset-choice {
        position: relative;
        display: flex;
        align-items: end;
        justify-content: center;
        min-height: 90px;
        padding: 0.65rem 0.3rem;
        border-radius: 2px;
        overflow: hidden;
        isolation: isolate;
        background: var(--surface);
        color: #fff;
        cursor: pointer;
        font-size: 0.7rem;
        text-align: center;
    }

    .preset-choice img, .preset-choice::before {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
    }

    .preset-choice img {
        z-index: -2;
        object-fit: cover;
        object-position: var(--wallpaper-position);
    }

    .preset-choice::before {
        content: "";
        background: linear-gradient(#10121120, #101211ee);
    }

    .preset-choice:has(:checked)::before {
        box-shadow: inset 0 0 0 2px var(--accent);
    }

    .preset-choice input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }

    .preset-choice:has(:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
    }

    .control-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 54px;
        padding-block: 0.5rem;
        border-bottom: 1px solid var(--line);
        font-size: 0.8rem;
    }

    .control-row > span {
        flex-shrink: 0;
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: end;
        gap: 0.6rem;
        min-height: 44px;
        padding: 0.4rem 0.7rem;
        max-width: 65%;
        border: 0;
        font-size: 0.72rem;
        text-align: right;
    }

    .theme-toggle :global(.icon) {
        width: 18px;
        height: 18px;
    }

    .control-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
    }

    .control-footer .text-link {
        border: 0;
        background: transparent;
        font-size: 0.75rem;
    }

    .preset-option {
        min-width: 0;
    }

    .preset-credit {
        font-size: 0.65rem;
        line-height: 1.5;
        color: var(--muted);
        margin: 0.6rem 0 0;
        overflow-wrap: anywhere;
    }
</style>
