---
import { useMessages } from "../../i18n/ui";
import { formatMessage } from "../../i18n/format";
import { languages, type Locale } from "../../config/site";
import { repositoryColor } from "../../config/theme";
import { formatSequenceNumber } from "../../utils/numbering";
import type { Repository } from "../../data/github/schema";
import Pagination from "../common/Pagination.astro";

interface Props {
    locale: Locale;
    repositories: readonly Repository[];
    filterable?: boolean;
    id: string;
}

const { locale, repositories, id, filterable = false } = Astro.props;
const copy = useMessages(locale).design;
---

<div class="repository-browser" data-repository-browser data-paginated-list data-format-locale={languages[locale].formatLocale}>
    {filterable && (
        <div class="repository-controls" data-repository-controls hidden>
            <div class="search-field">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="m15 15 5 5" stroke="currentColor" stroke-width="1.5" />
                </svg>
                <label class="sr-only" for={`${id}-search`}>{copy.search}</label>
                <input id={`${id}-search`} type="search" placeholder={copy.searchPlaceholder} autocomplete="off" data-repository-search />
            </div>
            <div class="repository-filter-bar">
                <div class="filter-options" role="group" aria-label={copy.repositoryType}>
                    {(["all", "original", "fork"] as const).map((type) => (
                        <button type="button" data-repository-filter={type} aria-pressed={type === "all"}>{copy[type]}</button>
                    ))}
                </div>
                <p class="result-count" role="status" aria-live="polite" aria-atomic="true" data-repository-count data-label={JSON.stringify(copy.results)}>
                    {formatMessage(copy.results, {
                        count: repositories.length,
                    }, languages[locale].formatLocale)}
                </p>
            </div>
        </div>
    )}
    <ol class="repository-list">
        {repositories.map((repository, index) => (
            <li
                class="repository-row"
                data-page-item
                data-repository
                data-type={repository.fork ? "fork" : "original"}
                data-search={`${repository.name} ${repository.description ?? ""} ${repository.language ?? ""}`.toLowerCase()}
            >
                <span class="row-index" data-repository-index aria-hidden="true">{formatSequenceNumber(index + 1, repositories.length)}</span>
                <div class="repository-content">
                    <div class="repository-title">
                        <h3><a href={repository.url}>{repository.name}</a></h3>
                        {repository.fork && <span class="fork-label">{copy.fork}</span>}
                    </div>
                    <p class="repository-description">{repository.description || copy.noDescription}</p>
                    <div class="repository-meta">
                        {repository.language && (
                            <span class="language-name">
                                <span class="language-dot" style={{ "--language-color": repositoryColor(repository.language) }} aria-hidden="true"></span>
                                {repository.language}
                            </span>
                        )}
                        {repository.stars > 0 && (
                            <span aria-label={formatMessage(copy.stars, {
                                count: repository.stars,
                            }, languages[locale].formatLocale)}>☆ {repository.stars}</span>
                        )}
                        <span>{copy.updated} <time datetime={repository.updatedAt}>{repository.updatedAt.slice(0, 10)}</time></span>
                    </div>
                </div>
                <span class="row-arrow" aria-hidden="true">↗</span>
            </li>
        ))}
    </ol>
    <Pagination locale={locale} />
    {filterable && (
        <div class="no-results" data-no-results hidden>
            <p>{copy.noResults}</p>
            <button class="text-button" type="button" data-clear-filters>{copy.reset}</button>
        </div>
    )}
</div>

<script>
    import { formatMessage } from "../../i18n/format";
    import { paginationFor } from "../../scripts/pagination";
    import { formatSequenceNumber } from "../../utils/numbering";

    document.querySelectorAll<HTMLElement>("[data-repository-browser]").forEach((browser) => {
        const controls = browser.querySelector<HTMLElement>("[data-repository-controls]");
        const search = browser.querySelector<HTMLInputElement>("[data-repository-search]");
        const count = browser.querySelector<HTMLElement>("[data-repository-count]");
        const empty = browser.querySelector<HTMLElement>("[data-no-results]");
        const buttons = [...browser.querySelectorAll<HTMLButtonElement>("[data-repository-filter]")];
        const rows = [...browser.querySelectorAll<HTMLElement>("[data-repository]")];
        if (! controls || ! search || ! count || ! empty) return;
        const pagination = paginationFor(browser);
        const countMessage = JSON.parse(count.dataset.label!);

        let selected = "all";
        const filter = () => {
            const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
            const matching = rows.filter((row) =>
                (selected === "all" || row.dataset.type === selected)
                && terms.every((term) => row.dataset.search?.includes(term)),
            );
            matching.forEach((row, index) => {
                row.querySelector<HTMLElement>("[data-repository-index]")!.textContent = formatSequenceNumber(index + 1, matching.length);
            });
            pagination.setItems(matching);
            count.textContent = formatMessage(countMessage, {
                count: matching.length,
            }, browser.dataset.formatLocale!);
            empty.hidden = matching.length > 0;
            buttons.forEach((button) =>
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.repositoryFilter === selected),
                ),
            );
        };

        controls.hidden = false;
        search.addEventListener("input", filter);
        buttons.forEach((button) =>
            button.addEventListener("click", () => {
                selected = button.dataset.repositoryFilter ?? "all";
                filter();
            }),
        );
        browser.querySelector("[data-clear-filters]")?.addEventListener("click", () => {
            search.value = "";
            selected = "all";
            filter();
            search.focus();
        });
    });
</script>
