---
import type { Locale } from "../../config/locales";
import { languages } from "../../config/locales";
import { mymusic5ProjectsLayout } from "../../config/collections";
import { mymusic5Url } from "../../config/mymusic5";
import { useMessages } from "../../i18n/ui";
import type { projectSources } from "../../services/projects/index";
import Sheets from "../common/mymusic5/Sheets.astro";
import Statistics from "../common/Statistics.astro";

interface Props {
    locale: Locale;
    data: ReturnType<typeof projectSources.mymusic5.load>;
}

const { locale, data } = Astro.props;
const { author, sheets, notice } = data;
const messages = useMessages(locale);
const copy = messages.mymusic5;
const formatLocale = languages[locale].formatLocale;
const number = new Intl.NumberFormat(formatLocale);
const levels: Record<number, string> = { 0: copy.beginner, 1: copy.easy, 2: copy.normal, 3: copy.hard, 4: copy.expert };
const difficultyCounts = new Map<number | null, number>(Object.keys(levels).map((level) => [Number(level), 0]));
for (const { level } of sheets) difficultyCounts.set(level, (difficultyCounts.get(level) ?? 0) + 1);
const statistics = [
    { label: copy.totalSheets, value: number.format(sheets.length) },
    ...Array.from(difficultyCounts)
        .sort(([a], [b]) => a === null ? 1 : b === null ? -1 : a - b)
        .map(([level, count]) => ({
            label: level === null ? copy.unspecifiedDifficulty : levels[level] ?? String(level),
            value: number.format(count),
        })),
];
---

{notice ? (
    <div class="mymusic5-catalog">
        <div class="sheet-author">
            {author && (
                <div class="sheet-identity">
                    {author.profileUrl && <img src={author.profileUrl} alt="" width="64" height="64" />}
                    <a href={mymusic5Url(author.artistUrl)}>{author.name}</a>
                </div>
            )}
        </div>
        <Statistics items={statistics} />
        {author && sheets.length > 0 ? (
            <Sheets
                id="mymusic5-sheets"
                label={copy.sheets}
                locale={locale}
                artistUrl={author.artistUrl}
                sheets={sheets}
                visibleItems={mymusic5ProjectsLayout.visibleItems}
            />
        ) : <p class="empty-message">{copy.noSheets}</p>}
    </div>
) : <p class="empty-message">{messages.content.unavailable}</p>}

<style>
    .sheet-author, .sheet-identity {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .sheet-author {
        flex-wrap: wrap;
        margin-block: 1.25rem;
    }

    .sheet-identity img {
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        flex: none;
    }

    .sheet-identity a {
        font-size: 1.25rem;
        font-weight: 600;
        overflow-wrap: anywhere;
    }
</style>
