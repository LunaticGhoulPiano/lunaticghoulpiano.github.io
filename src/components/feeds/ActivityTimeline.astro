---
import type { Locale } from "../../config/site";
import { formatMessage } from "../../i18n/format";
import { languages } from "../../config/site";
import { useMessages } from "../../i18n/ui";
import type { ActivityEntry } from "../../services/feeds/github";

interface Props {
    locale: Locale;
    entries: ActivityEntry[];
}

const { locale, entries } = Astro.props;
const copy = useMessages(locale);
---

<ol class="activity-list">
    {entries.map((entry) => (
        <li class="focus-item" data-private-contributions={entry.type === "PrivateContribution" || undefined}>
            <time datetime={entry.occurredAt}>{entry.occurredAt.slice(0, 10)}</time>
            <div>
                <p class="activity-action">
                    {entry.type === "PrivateContribution"
                        ? formatMessage(copy.activity.privateCount, {
                            count: entry.quantity,
                        }, languages[locale].formatLocale)
                        : entry.type === "Commit"
                        ? formatMessage(copy.activity.commitCount, {
                            count: entry.quantity,
                        }, languages[locale].formatLocale)
                        : copy.events[entry.type]}
                </p>
                {entry.type === "PrivateContribution" ? (
                    <span class="activity-repository">{copy.activity.privateRepository}</span>
                ) : (
                    <a class="activity-repository" href={entry.url}>{entry.repository} ↗</a>
                )}
            </div>
        </li>
    ))}
</ol>

<style>
    .activity-list > li {
        height: var(--activity-item-height);
        line-height: 1.5;
    }

    .activity-list > li > div { min-width: 0; }

    .activity-repository {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--activity-repository-lines);
        line-clamp: var(--activity-repository-lines);
        overflow: hidden;
        max-width: 100%;
        font-size: 1rem;
        overflow-wrap: anywhere;
    }

    @media print {
        .activity-list > li { height: auto; }
    }
</style>
