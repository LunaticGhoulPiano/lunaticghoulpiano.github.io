---
import type { Locale } from "../../config/locales";
import { languages } from "../../config/locales";
import { youtubeTimelinePreviewSize, youtubeVideoLayout, youtubePageLayout, youtubePlaylistNavigation, youtubeVideoSortOptions } from "../../config/collections";
import { useMessages } from "../../i18n/ui";
import { displayDate, displayDuration } from "../../utils/dates";
import type { FeedData } from "../../services/feeds/index";
import TimelineViewport from "../common/TimelineViewport.astro";
import Carousel from "../common/Carousel.astro";

interface Props {
    locale: Locale;
    preview?: boolean;
    data: FeedData;
}

const { locale, preview = false, data } = Astro.props;
if (! ("channel" in data)) throw new Error("YouTube requires YouTube feed data.");
const { channel, videos, library, playlists } = data;
const uploads = new Set(videos.map((video) => video.id));
const rows = preview ? videos : [...videos, ...library.filter((video) => ! uploads.has(video.id))];
const messages = useMessages(locale);
const copy = messages.youtube;
const number = new Intl.NumberFormat(languages[locale].formatLocale);
const count = (value: string | null) => value === null ? "—" : number.format(BigInt(value));
---

{channel ? (
    <>
        <div class="youtube-channel">
            {channel.avatar && <img class="youtube-avatar" src={channel.avatar} alt="" width="64" height="64" />}
            <div class="youtube-identity">
                <a class="youtube-name" href={`https://www.youtube.com/channel/${channel.id}`}>{channel.title}</a>
            </div>
        </div>
        <dl class="youtube-statistics">
            <div><dt>{copy.subscribers}</dt><dd>{count(channel.subscribers)}</dd></div>
            <div><dt>{copy.created}</dt><dd><time datetime={channel.createdAt}>{displayDate(channel.createdAt)}</time></dd></div>
            <div><dt>{copy.publicVideos}</dt><dd>{count(channel.publicVideos)}</dd></div>
            <div><dt>{copy.views}</dt><dd>{count(channel.views)}</dd></div>
        </dl>
        <div class:list={{ "youtube-browser": ! preview }} data-youtube-browser={! preview || undefined} data-carousel-hover={! preview || undefined} style={{
            "--youtube-wide-item-height": `${youtubePageLayout.itemHeight}px`,
            "--youtube-mobile-item-height": `${youtubePageLayout.mobileItemHeight}px`,
            "--youtube-page-size": youtubePageLayout.visibleItems,
            "--youtube-playlist-description-lines": youtubePageLayout.playlistDescriptionLines,
        }}>
            {! preview && playlists.length > 0 && (
                <>
                    <div data-youtube-controls hidden>
                        <Carousel
                            id="youtube-playlists"
                            label={copy.playlists}
                            locale={locale}
                            visibleItems={youtubePlaylistNavigation.visibleItems}
                            interval={youtubePlaylistNavigation.interval}
                            slideDuration={youtubePlaylistNavigation.duration}
                            navigation
                            loop
                        >
                            <button type="button" data-youtube-filter="" data-video-ids={JSON.stringify(videos.map((video) => video.id))} data-description="" aria-pressed="true" title={copy.all}>{copy.all}</button>
                            {playlists.map((playlist) => (
                                <button type="button" data-youtube-filter={playlist.id} data-video-ids={JSON.stringify(playlist.items.map((item) => item.videoId))} data-description={playlist.description} aria-pressed="false" title={playlist.title}>{playlist.title}</button>
                            ))}
                        </Carousel>
                    </div>
                </>
            )}
            {! preview && (
                <div class="youtube-toolbar">
                    <p class="youtube-playlist-description" data-youtube-description></p>
                    <div class="youtube-sort" data-youtube-sort-controls hidden>
                        <label for="youtube-sort">{copy.sortBy}</label>
                        <select id="youtube-sort" data-youtube-sort autocomplete="off">
                            {youtubeVideoSortOptions.map((option) => (
                                <option value={option} selected={option === youtubeVideoSortOptions[0]}>{copy[option]}</option>
                            ))}
                        </select>
                    </div>
                </div>
            )}
            {videos.length > 0 || ! preview ? (
                <TimelineViewport
                    id={preview ? "youtube-preview-timeline" : "youtube-timeline"}
                    label={copy.videos}
                    locale={locale}
                    visibleItems={preview ? youtubeTimelinePreviewSize : youtubePageLayout.visibleItems}
                    height={preview ? undefined : "calc(var(--youtube-item-height) * var(--youtube-page-size))"}
                    chronological={preview}
                >
                    <ol class="activity-list youtube-videos" style={{
                        "--youtube-title-lines": youtubeVideoLayout.titleLines,
                        "--youtube-description-lines": youtubeVideoLayout.descriptionLines,
                    }}>
                        {rows.map((video) => (
                            <li data-video-id={video.id} data-video-views={preview ? undefined : video.views} data-video-likes={preview ? undefined : video.likes} hidden={! uploads.has(video.id)}>
                                <time datetime={video.publishedAt}>{video.publishedAt.slice(0, 10)}</time>
                                <div>
                                    <div class="youtube-video">
                                        {video.thumbnail && (
                                            <a class="youtube-thumbnail" href={`https://www.youtube.com/watch?v=${video.id}`} tabindex="-1" aria-hidden="true">
                                                <img src={video.thumbnail} alt="" width="160" height="90" loading="lazy" />
                                            </a>
                                        )}
                                        <div class="youtube-video-content">
                                            <a class="youtube-video-title" href={`https://www.youtube.com/watch?v=${video.id}`}>{video.title} ↗</a>
                                            <div class="youtube-video-details">
                                                {video.description && <p class="youtube-description">{video.description.replace(/\n\s*\n/g, "\n")}</p>}
                                                <dl class="youtube-video-statistics">
                                                    <div><dt>{copy.duration}</dt><dd>{displayDuration(video.durationSeconds)}</dd></div>
                                                    <div><dt>{copy.videoViews}</dt><dd>{count(video.views)}</dd></div>
                                                    <div><dt>{copy.likes}</dt><dd>{count(video.likes)}</dd></div>
                                                </dl>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        ))}
                    </ol>
                    {! preview && <p class="empty-message" data-youtube-empty data-all-label={copy.noVideos} data-playlist-label={copy.emptyPlaylist} role="status" hidden={videos.length > 0}>{copy.noVideos}</p>}
                </TimelineViewport>
            ) : <p class="empty-message">{copy.noVideos}</p>}
        </div>
    </>
) : <p class="empty-message">{messages.content.unavailable}</p>}

<style>
    .youtube-browser {
        --youtube-item-height: var(--youtube-wide-item-height);
    }

    .youtube-playlist-description {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--youtube-playlist-description-lines);
        height: calc(var(--youtube-playlist-description-lines) * 1lh);
        overflow: hidden;
        overflow-wrap: anywhere;
        color: var(--muted);
        font-size: 0.875rem;
        margin: 0;
    }

    .youtube-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        margin-top: 0.75rem;
    }

    .youtube-sort {
        display: flex;
        align-items: center;
        justify-self: end;
        gap: 0.5rem;
        min-width: 0;
        font-size: 0.875rem;
        color: var(--muted);
    }

    .youtube-sort label {
        white-space: nowrap;
    }

    .youtube-sort select {
        min-width: 0;
        min-height: 2.25rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--line);
        color: var(--text);
        background: var(--background);
        font: inherit;
    }

    .youtube-browser .youtube-videos > li {
        height: var(--youtube-item-height);
    }

    .youtube-channel {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .youtube-avatar {
        flex: none;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
    }

    .youtube-identity {
        min-width: 0;
    }

    .youtube-name {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .youtube-statistics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-block: 1.5rem;
    }

    .youtube-statistics dt {
        color: var(--muted);
        font-size: 0.75rem;
    }

    .youtube-statistics dd {
        margin: 0.4rem 0 0;
        font-size: 0.9375rem;
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
    }

    .youtube-video {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .youtube-video img {
        display: block;
        width: 10rem;
        height: 5.625rem;
        object-fit: cover;
        border-radius: 0.75rem 0;
    }

    .youtube-thumbnail {
        flex: none;
    }

    .youtube-video-content {
        flex: 1;
        min-width: 0;
    }

    .youtube-video-title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--youtube-title-lines);
        block-size: calc(var(--youtube-title-lines) * 1lh);
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .youtube-video-details {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 1rem;
        margin-top: 0.5rem;
        padding-inline-end: clamp(1rem, 12%, 4rem);
        font-size: 0.875rem;
        line-height: 1.6;
        block-size: calc(var(--youtube-description-lines) * 1lh);
    }

    .youtube-description {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--youtube-description-lines);
        overflow: hidden;
        overflow-wrap: anywhere;
        white-space: pre-line;
        color: var(--muted);
    }

    .youtube-video-statistics {
        grid-column: 2;
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.6;
    }

    .youtube-video-statistics > div {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .youtube-video-statistics dt {
        color: var(--muted);
    }

    .youtube-video-statistics dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 46rem) {
        .youtube-browser {
            --youtube-item-height: var(--youtube-mobile-item-height);
        }
        .youtube-statistics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .youtube-video {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: 3.375rem auto;
            gap: 0.75rem;
        }

        .youtube-thumbnail {
            grid-row: 1;
        }

        .youtube-video-content {
            grid-row: 2;
        }

        .youtube-video img {
            width: 6rem;
            height: 3.375rem;
        }
    }
</style>

<script>
    import { initializeYoutubePlaylists } from "../../scripts/youtube";
    initializeYoutubePlaylists();
</script>
