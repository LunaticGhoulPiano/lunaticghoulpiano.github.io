---
import { languages, type Locale } from "../../config/locales";
import RecentFeed from "../common/RecentFeed.astro";
import { useMessages } from "../../i18n/ui";
import { formatMessage } from "../../i18n/format";
import type { getYoutubeContent } from "../../data/youtube/content";
import Videos from "../common/youtube/Videos.astro";
import TimelineViewport from "../common/TimelineViewport.astro";
import { youtubeFeedTimelineSize, youtubeFeedVideoLimit } from "../../config/collections";

interface Props {
    locale: Locale;
    data: ReturnType<typeof getYoutubeContent>;
}

const { locale, data } = Astro.props;
const messages = useMessages(locale);
const copy = messages.youtube;
const { channel } = data;
const videos = data.videos.slice(0, youtubeFeedVideoLimit);
const title = formatMessage(copy.latestVideos, { count: youtubeFeedVideoLimit }, languages[locale].formatLocale);
---

<RecentFeed locale={locale} title={title} available={Boolean(channel)} empty={videos.length === 0} emptyMessage={copy.noVideos}>
    <TimelineViewport id="youtube-feed-timeline" label={title} locale={locale} visibleItems={youtubeFeedTimelineSize}>
        <Videos locale={locale} videos={videos} />
    </TimelineViewport>
</RecentFeed>
