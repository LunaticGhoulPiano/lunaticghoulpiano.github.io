---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../common/ContentList.astro";
import type { Locale } from "../../config/site";
import { getRoutePath } from "../../routing";
import { getTaxonomyContext } from "../../services/blog/index";
import type { Taxonomy } from "../../config/content";
import { useMessages } from "../../i18n/ui";

interface Props {
    taxonomy: Taxonomy;
    value: string;
    locale: Locale;
}

const { taxonomy, value, locale } = Astro.props;
const copy = useMessages(locale).content;
const { items, languagePaths, route, title, path, allLabel } = await getTaxonomyContext(taxonomy, value, locale);
---

<BaseLayout
    title={title}
    locale={locale}
    route={route}
    pagePath={path}
    languagePaths={languagePaths}
>
    <header class="page-heading">
        <a class="text-link" href={getRoutePath(route, locale)}>← {copy[allLabel]}</a>
        <h1>{title}</h1>
    </header>
    <ContentList locale={locale} items={items} />
</BaseLayout>
