---
import { contentRules } from "../../config/content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { getContentContext, ContentEntry } from "../../data/contents";
import { contentPath, categoryPath, tagPath, getRoutePath } from "../../routing";
import { tagName } from "../../data/taxonomy";
import { useMessages } from "../../i18n/ui";

interface Props {
    post: ContentEntry;
    context: ReturnType<typeof getContentContext>;
}

const { post, context } = Astro.props;
const { locale } = post.data;
const copy = useMessages(locale).content;
const { related, languagePaths, route } = context;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => (contentRules.tocDepths as readonly number[]).includes(heading.depth));
---

<BaseLayout
    article={post.data}
    title={post.data.title}
    description={post.data.description}
    locale={locale}
    route={route}
    pagePath={contentPath(post)}
    languagePaths={languagePaths}
>
    <article>
        <header class="page-heading">
            <a class="text-link" href={getRoutePath(route, locale)}>← {copy.backToList}</a>
            <h1>{post.data.title}</h1>
            <p class="post-meta">
                <a href={categoryPath(post.data.category, locale, route)}>{post.data.category}</a> ·
                <time datetime={post.data.date}>{post.data.date}</time>
                {post.data.updated && (
                    <>
                        · {copy.updated}
                        <time datetime={post.data.updated}>{post.data.updated}</time>
                    </>
                )}
            </p>
            <p class="page-description">{post.data.description}</p>
            <ul class="tag-list">
                {post.data.tags.map((tag) => (
                    <li><a href={tagPath(tag, locale, route)}>{tagName(tag, locale)}</a></li>
                ))}
            </ul>
            {post.data.links.length > 0 && (
                <nav class="article-links" aria-label={copy.links}>
                    <span>{copy.links}</span>
                    <ul>
                        {post.data.links.map((link) => (
                            <li><a href={link.url}>{link.label}</a></li>
                        ))}
                    </ul>
                </nav>
            )}
        </header>
        {toc.length > 0 && (
            <details class="article-toc" data-glass-rule open>
                <summary>{copy.contents}</summary>
                <nav aria-label={copy.articleContents}>
                    <ol>
                        {toc.map((heading) => (
                            <li
                                class:list={{ "toc-child": heading.depth > Math.min(...contentRules.tocDepths) }}
                            >
                                <a href={`#${heading.slug}`}>{heading.text}</a>
                            </li>
                        ))}
                    </ol>
                </nav>
            </details>
        )}
        <div class="prose">
            <Content />
        </div>
        {related.length > 0 && (
            <aside class="content-section">
                <h2>{copy.relatedContent}</h2>
                <ul>
                    {related.map((entry) => (
                        <li><a href={contentPath(entry)}>{entry.data.title}</a></li>
                    ))}
                </ul>
            </aside>
        )}
    </article>
</BaseLayout>

<style>
    .article-links, .article-links ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem 1rem;
    }

    .article-links {
        margin-block: 0.75rem;
        font-size: 0.875rem;
        overflow-wrap: anywhere;
    }

    .article-links ul {
        margin: 0;
        padding: 0;
        list-style: none;
        min-width: 0;
    }

    .article-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
    }
</style>
