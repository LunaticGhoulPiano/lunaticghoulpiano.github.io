---
import { useMessages } from "../../i18n/ui";
import { displayDate, displayTimestamp } from "../../utils/dates";
import { type Locale } from "../../config/site";
import { snapshotStatus } from "../../data/snapshot";

interface Props {
    locale: Locale;
    snapshot: {
        lastSuccessfulFetchAt: string;
    } | null;
    showMissingTimestamp?: boolean;
    period?: { from: string; to: string } | null;
}
const { locale, snapshot, showMissingTimestamp = false, period } = Astro.props;
const copy = useMessages(locale).content;
const status = snapshotStatus(snapshot);
const time = snapshot && displayTimestamp(snapshot.lastSuccessfulFetchAt, locale);
---

<div class="snapshot-notice">
    {snapshot ? (
        <>
            {period && <p><time datetime={period.from}>{displayDate(period.from)}</time> ~ <time datetime={period.to}>{displayDate(period.to)}</time></p>}
            <p>{copy.snapshot}: <time datetime={snapshot.lastSuccessfulFetchAt}>{time}</time></p>
            {status === "stale" && <p>{copy.stale}</p>}
        </>
    ) : (
        <p>{showMissingTimestamp ? `${copy.snapshot}: —` : copy.unavailable}</p>
    )}
</div>
