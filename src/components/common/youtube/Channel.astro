---
import type { Locale } from "../../../config/locales";
import { languages } from "../../../config/locales";
import { countFormatter } from "../../../i18n/format";
import { useMessages } from "../../../i18n/ui";
import type { YoutubeSnapshot } from "../../../data/youtube/schema";
import { displayDate } from "../../../utils/dates";
import Statistics from "../Statistics.astro";

interface Props {
    locale: Locale;
    channel: YoutubeSnapshot["channel"];
}

const { locale, channel } = Astro.props;
const copy = useMessages(locale).youtube;
const count = countFormatter(languages[locale].formatLocale);
---

<div class="youtube-channel">
    {channel.avatar && <img class="youtube-avatar" src={channel.avatar} alt="" width="64" height="64" />}
    <div class="youtube-identity">
        <a class="youtube-name" href={`https://www.youtube.com/channel/${channel.id}`}>{channel.title}</a>
    </div>
</div>
<Statistics items={[
    { label: copy.subscribers, value: count(channel.subscribers) },
    { label: copy.created, value: displayDate(channel.createdAt), datetime: channel.createdAt },
    { label: copy.publicVideos, value: count(channel.publicVideos) },
    { label: copy.views, value: count(channel.views) },
]} />

<style>
    .youtube-channel {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .youtube-avatar {
        flex: none;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
    }

    .youtube-identity {
        min-width: 0;
    }

    .youtube-name {
        font-size: 1.25rem;
        font-weight: 600;
    }

</style>
