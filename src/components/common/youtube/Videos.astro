---
import type { Locale } from "../../../config/locales";
import { languages } from "../../../config/locales";
import { useMessages } from "../../../i18n/ui";
import type { YoutubeSnapshot } from "../../../data/youtube/schema";
import { youtubeVideoLayout } from "../../../config/collections";
import { displayDuration } from "../../../utils/dates";

interface Props {
    locale: Locale;
    videos: YoutubeSnapshot["videos"];
    visibleIds?: Set<string>;
}

const { locale, videos, visibleIds } = Astro.props;
const copy = useMessages(locale).youtube;
const number = new Intl.NumberFormat(languages[locale].formatLocale);
const count = (value: string | null) => value === null ? "—" : number.format(BigInt(value));
---

<ol class="activity-list youtube-videos" style={{
    "--youtube-title-lines": youtubeVideoLayout.titleLines,
    "--youtube-description-lines": youtubeVideoLayout.descriptionLines,
}}>
    {videos.map((video) => (
        <li data-video-id={video.id} data-video-views={video.views} data-video-likes={video.likes} hidden={visibleIds && ! visibleIds.has(video.id)}>
            <time datetime={video.publishedAt}>{video.publishedAt.slice(0, 10)}</time>
            <div>
                <div class="youtube-video">
                    {video.thumbnail && (
                        <a class="youtube-thumbnail" href={`https://www.youtube.com/watch?v=${video.id}`} tabindex="-1" aria-hidden="true">
                            <img src={video.thumbnail} alt="" width="160" height="90" loading="lazy" />
                        </a>
                    )}
                    <div class="youtube-video-content">
                        <a class="youtube-video-title" href={`https://www.youtube.com/watch?v=${video.id}`}>{video.title} ↗</a>
                        <div class="youtube-video-details">
                            {video.description && <p class="youtube-description">{video.description.replace(/\n\s*\n/g, "\n")}</p>}
                            <dl class="youtube-video-statistics">
                                <div><dt>{copy.duration}</dt><dd>{displayDuration(video.durationSeconds)}</dd></div>
                                <div><dt>{copy.videoViews}</dt><dd>{count(video.views)}</dd></div>
                                <div><dt>{copy.likes}</dt><dd>{count(video.likes)}</dd></div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </li>
    ))}
</ol>

<style>
    .youtube-video {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .youtube-video img {
        display: block;
        width: 10rem;
        height: 5.625rem;
        object-fit: cover;
        border-radius: 0.75rem 0;
    }

    .youtube-thumbnail {
        flex: none;
    }

    .youtube-video-content {
        flex: 1;
        min-width: 0;
    }

    .youtube-video-title {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--youtube-title-lines);
        block-size: calc(var(--youtube-title-lines) * 1lh);
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .youtube-video-details {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 1rem;
        margin-top: 0.5rem;
        padding-inline-end: clamp(1rem, 12%, 4rem);
        font-size: 0.875rem;
        line-height: 1.6;
        block-size: calc(var(--youtube-description-lines) * 1lh);
    }

    .youtube-description {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--youtube-description-lines);
        overflow: hidden;
        overflow-wrap: anywhere;
        white-space: pre-line;
        color: var(--muted);
    }

    .youtube-video-statistics {
        grid-column: 2;
        margin: 0;
        font-size: 0.75rem;
        line-height: 1.6;
    }

    .youtube-video-statistics > div {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .youtube-video-statistics dt {
        color: var(--muted);
    }

    .youtube-video-statistics dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 46rem) {
        .youtube-video {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: 3.375rem auto;
            gap: 0.75rem;
        }

        .youtube-thumbnail {
            grid-row: 1;
        }

        .youtube-video-content {
            grid-row: 2;
        }

        .youtube-video img {
            width: 6rem;
            height: 3.375rem;
        }
    }
</style>
