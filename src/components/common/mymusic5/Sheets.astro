---
import { languages, type Locale } from "../../../config/locales";
import { mymusic5SheetLayout } from "../../../config/collections";
import { mymusic5Url } from "../../../config/mymusic5";
import type { Mymusic5Snapshot } from "../../../data/mymusic5/schema";
import { useMessages } from "../../../i18n/ui";
import { displayDate } from "../../../utils/dates";
import { formatSequenceNumber } from "../../../utils/numbering";
import TimelineViewport from "../TimelineViewport.astro";

interface Props {
    id: string;
    label: string;
    locale: Locale;
    artistUrl: string;
    sheets: Mymusic5Snapshot["sheets"];
    visibleItems: number;
    chronological?: boolean;
}

const { id, label, locale, artistUrl, sheets, visibleItems, chronological = false } = Astro.props;
const copy = useMessages(locale).mymusic5;
const formatLocale = languages[locale].formatLocale;
const number = new Intl.NumberFormat(formatLocale);
const levels: Record<number, string> = { 0: copy.beginner, 1: copy.easy, 2: copy.normal, 3: copy.hard, 4: copy.expert };
const instruments: Record<string, string> = { "piano-88keys": copy.piano, kalimba: copy.kalimba, "bass-guitar": copy.bass, drum: copy.drums };
const sheetTypes: Record<string, string> = { "1staff": copy.oneStaff, "2staves": copy.twoStaves, tab: copy.tablature };
const price = (sheet: (typeof sheets)[number]) => sheet.isFree ? copy.free
    : new Intl.NumberFormat(formatLocale, { style: "currency", currency: sheet.currency, currencyDisplay: "code" }).format(sheet.price);
---

<div class="mymusic5-sheets" style={{
    "--sheet-wide-height": `${mymusic5SheetLayout.itemHeight}px`,
    "--sheet-mobile-height": `${mymusic5SheetLayout.mobileItemHeight}px`,
    "--sheet-visible-items": visibleItems,
    "--sheet-title-lines": mymusic5SheetLayout.titleLines,
    "--sheet-description-lines": mymusic5SheetLayout.descriptionLines,
}}>
    <TimelineViewport
        id={id}
        label={label}
        locale={locale}
        visibleItems={visibleItems}
        height="calc(var(--sheet-item-height) * var(--sheet-visible-items))"
        chronological={chronological}
    >
        <ol class="sheet-list">
            {sheets.map((sheet, index) => {
                const url = mymusic5Url(artistUrl, sheet.sheetId);
                const title = sheet.metaSong || sheet.title;
                const attributes = [
                    ...sheet.instruments.map((instrument) => instruments[instrument] ?? instrument),
                    sheet.level === null ? null : levels[sheet.level] ?? String(sheet.level),
                    sheet.instrumentation === "solo" ? copy.solo : sheet.instrumentation === "unspecified" ? null : sheet.instrumentation,
                    sheet.sheetType && (sheetTypes[sheet.sheetType] ?? sheet.sheetType),
                    sheet.includeChord ? copy.chords : null,
                    sheet.includeLyrics ? copy.lyrics : null,
                ].filter(Boolean);
                return (
                    <li data-sheet-id={sheet.sheetId}>
                        <span class="sheet-number" aria-hidden="true">{formatSequenceNumber(index + 1, sheets.length)}</span>
                        <a class="sheet-cover" href={url} aria-label={title} tabindex="-1">
                            {sheet.thumbnailUrl && <img src={sheet.thumbnailUrl} alt="" width="96" height="139" loading="lazy" decoding="async" />}
                        </a>
                        <div class="sheet-content">
                            <h3><a href={url}>{title} ↗</a></h3>
                            {sheet.metaMusician && <p class="sheet-musician">{sheet.metaMusician}</p>}
                            <p class="sheet-attributes">{attributes.join(" · ")}</p>
                            {sheet.description && <p class="sheet-description">{sheet.description}</p>}
                            <div class="sheet-dates">
                                <span>{copy.uploaded} <time datetime={sheet.createdAt}>{displayDate(sheet.createdAt)}</time></span>
                                <span>{copy.updated} <time datetime={sheet.updatedAt}>{displayDate(sheet.updatedAt)}</time></span>
                            </div>
                        </div>
                        <div class="sheet-aside">
                            <p class="sheet-price">{price(sheet)}</p>
                            <p class="sheet-likes">{copy.likes} {number.format(sheet.likes)}</p>
                            {sheet.youtubeId && <a class="sheet-video" href={`https://www.youtube.com/watch?v=${sheet.youtubeId}`}>YouTube ↗</a>}
                        </div>
                    </li>
                );
            })}
        </ol>
    </TimelineViewport>
</div>

<style>
    .mymusic5-sheets {
        --sheet-item-height: var(--sheet-wide-height);
    }

    .sheet-number, .sheet-attributes, .sheet-description, .sheet-dates, .sheet-likes {
        color: var(--muted);
        font-size: 0.8125rem;
    }

    .sheet-list {
        list-style: none;
        margin: 0;
        padding: 0 1rem 0 0;
    }

    .sheet-list li {
        display: grid;
        grid-template-columns: 2ch 6rem minmax(0, 1fr) 7rem;
        align-items: center;
        gap: 1.25rem;
        height: var(--sheet-item-height);
        padding-block: 1rem;
        border-bottom: 1px solid var(--line);
    }

    .sheet-number {
        font-family: var(--mono);
    }

    .sheet-cover img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 9rem;
        object-fit: contain;
        border-radius: 0.75rem 0 0.75rem 0;
    }

    .sheet-content {
        min-width: 0;
    }

    .sheet-content h3, .sheet-description {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: var(--sheet-title-lines);
        overflow: hidden;
        overflow-wrap: anywhere;
    }

    .sheet-content h3 {
        font-size: 1rem;
        line-height: 1.5;
        margin: 0;
    }

    .sheet-musician {
        font-size: 0.875rem;
        margin: 0.25rem 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sheet-attributes {
        margin: 0.4rem 0;
    }

    .sheet-description {
        -webkit-line-clamp: var(--sheet-description-lines);
        margin: 0.25rem 0;
    }

    .sheet-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 0.1rem 1rem;
        margin-top: 0.5rem;
        font-size: 0.75rem;
    }

    .sheet-aside {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .sheet-price {
        font-size: 0.9375rem;
        margin: 0;
    }

    .sheet-likes {
        margin: 0.4rem 0;
    }

    .sheet-video {
        font-size: 0.8125rem;
    }

    @media (max-width: 46rem) {
        .mymusic5-sheets {
            --sheet-item-height: var(--sheet-mobile-height);
        }

        .sheet-list li {
            grid-template-columns: 4.5rem minmax(0, 1fr);
            gap: 0.5rem 0.9rem;
        }

        .sheet-number {
            display: none;
        }

        .sheet-aside {
            grid-column: 2;
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.25rem 0.75rem;
            text-align: left;
        }

        .sheet-aside p {
            margin: 0;
        }
    }
</style>
