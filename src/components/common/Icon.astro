---
import profile from "../../assets/icons/user-round.svg?raw";
import feeds from "../../assets/icons/radio.svg?raw";
import projects from "../../assets/icons/folder-code.svg?raw";
import playground from "../../assets/icons/flask-conical.svg?raw";
import blog from "../../assets/icons/notebook-pen.svg?raw";
import documentations from "../../assets/icons/book-open.svg?raw";
import search from "../../assets/icons/search.svg?raw";
import controls from "../../assets/icons/sliders-horizontal.svg?raw";
import close from "../../assets/icons/x.svg?raw";
import arrow from "../../assets/icons/arrow-up-right.svg?raw";
import reset from "../../assets/icons/rotate-ccw.svg?raw";
import contrast from "../../assets/icons/contrast.svg?raw";

const icons = { profile, feeds, projects, playground, blog, documentations, search, controls, close, arrow, reset, contrast };
interface Props { name: keyof typeof icons; }
---
<span class="icon" aria-hidden="true" set:html={icons[Astro.props.name]} />

<style>
    .icon {
        display: inline-flex;
        flex: 0 0 auto;
        width: 20px;
        height: 20px;
        align-items: center;
        justify-content: center;
    }

    .icon :global(svg) {
        width: 100%;
        height: 100%;
        stroke-width: 1.65;
    }
</style>
