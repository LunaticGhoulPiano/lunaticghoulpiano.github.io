---
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";

interface Props extends HTMLAttributes<"input"> {
    id: string;
    label: string;
}

const { id, label, ...attributes } = Astro.props;
---

<div class="search-field" data-glass="control">
    <Icon name="search" />
    <label class="sr-only" for={id}>{label}</label>
    <input id={id} type="search" autocomplete="off" {...attributes} />
</div>
