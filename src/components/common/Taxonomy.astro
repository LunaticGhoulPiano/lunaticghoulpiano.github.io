---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "./ContentList.astro";
import type { getTaxonomyContext } from "../../services/index";
import { useMessages } from "../../i18n/ui";

interface Props {
    context: ReturnType<typeof getTaxonomyContext>;
}

const { items, languagePaths, route, title, path, indexHref, allLabel, locale, placement } = Astro.props.context;
const copy = useMessages(locale).content;
---

<BaseLayout
    title={title}
    locale={locale}
    route={route}
    pagePath={path}
    languagePaths={languagePaths}
>
    <header class="page-heading">
        <a class="text-link" href={indexHref}>← {copy[allLabel]}</a>
        <h1>{title}</h1>
    </header>
    <ContentList locale={locale} items={items} placement={placement} />
</BaseLayout>
