---
import type { Locale } from "../../config/locales";
import { useMessages } from "../../i18n/ui";
import Icon from "./Icon.astro";
interface Props { id: string; title: string; locale: Locale; }
const { id, title, locale } = Astro.props;
---
<dialog id={id} class="shell-panel" data-panel data-glass="surface" aria-labelledby={`${id}-title`}>
    <div class="panel-body">
        <header class="panel-heading" data-glass="controls">
            <h2 id={`${id}-title`}>{title}</h2>
            <button class="icon-button" type="button" data-panel-close aria-label={useMessages(locale).shell.close}><Icon name="close" /></button>
        </header>
        <slot />
    </div>
</dialog>

<script>
    import { initializePanels } from "../../scripts/panels";
    initializePanels();
    document.addEventListener("astro:page-load", initializePanels);
</script>

<style>
    :global(body:has(dialog[data-panel][open])) {
        overflow: hidden;
    }

    .shell-panel {
        color: var(--text);
        padding: 0;
        border-radius: var(--glass-corner);
        overflow: hidden;
        font-size: 0.9rem;
        width: min(25rem, calc(100% - 2rem));
        /* Width is controlled here, including the full-width mobile layout. */
        max-width: none;
        --panel-max-height: calc(100dvh - 6rem);
        max-height: var(--panel-max-height);
        inset: 5rem 1.5rem auto auto;
        margin: 0;
    }

    .panel-body {
        padding: 1.4rem;
        max-height: var(--panel-max-height);
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .shell-panel::backdrop {
        background: var(--glass-scrim);
    }

    .panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .panel-heading h2 {
        font-size: 1rem;
    }

    @media (prefers-reduced-motion: no-preference) {

        .shell-panel[open] {
            animation: panel-enter 180ms ease-out both;
        }

        @keyframes panel-enter {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: none;
            }

        }

    }

    @media (max-width: 48rem) {

        .shell-panel {
            inset: auto 0 0;
            width: 100%;
            --panel-max-height: 90dvh;
            margin: 0;
            border-radius: var(--glass-corner) var(--glass-corner) 0 0;
        }

        .panel-body {
            padding: 1.1rem 1.1rem calc(1.1rem + env(safe-area-inset-bottom));
        }
    }

    @media print {
        .shell-panel {
            display: none;
        }

    }
</style>
