---
import type { Locale } from "../../config/site";
import type { ContentEntry } from "../../data/contents";
import { contentPath, categoryPath, tagPath } from "../../routing";
import { tagName } from "../../data/taxonomy";
import { useMessages } from "../../i18n/ui";
import ContentTransition from "./ContentTransition.astro";
import Pagination from "./Pagination.astro";

interface Props {
    locale: Locale;
    items: ContentEntry[];
    placement?: string;
    animatePages?: boolean;
}

const { locale, items, placement, animatePages = false } = Astro.props;
const copy = useMessages(locale).content;
const ListFrame = animatePages ? ContentTransition : Fragment;
---

<div data-paginated-list>
    <ListFrame>
        <ol class="post-list">
            {items.map((item) => (
                <li class="focus-item" data-page-item data-reveal-item>
                    <p class="post-meta">
                        <a href={categoryPath(item.data.category, locale, placement)}>{item.data.category}</a> · {copy.updated}
                        <time datetime={item.data.updated ?? item.data.date}>{item.data.updated ?? item.data.date}</time>
                    </p>
                    <h2><a href={contentPath(item)}>{item.data.title}</a></h2>
                    <p>{item.data.description}</p>
                    {item.data.tags.length > 0 && (
                        <ul class="tag-list">
                            {item.data.tags.map((tag) => (
                                <li><a href={tagPath(tag, locale, placement)}>{tagName(tag, locale)}</a></li>
                            ))}
                        </ul>
                    )}
                </li>
            ))}
        </ol>
    </ListFrame>
    <Pagination locale={locale} animatePages={animatePages} />
</div>
