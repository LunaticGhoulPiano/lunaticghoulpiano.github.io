---
import type { Locale } from "../../config/site";
import { useMessages } from "../../i18n/ui";

interface Props {
    id: string;
    label: string;
    locale: Locale;
    visibleItems: number;
    height?: number | string;
    chronological?: boolean;
}

const { id, label, locale, visibleItems, height, chronological = true } = Astro.props;
const copy = useMessages(locale).timeline;
const start = chronological ? copy.newest : copy.first;
const end = chronological ? copy.oldest : copy.last;
---

<div class="timeline-window" data-timeline-window data-visible-items={visibleItems} data-height={height}>
    <button
        class="timeline-jump"
        type="button"
        data-timeline-newest
        aria-label={start}
        title={start}
        aria-controls={id}
        hidden
    >↑</button>
    <div
        class="timeline-scroll"
        id={id}
        data-timeline-scroll
        data-reveal-list
        tabindex="0"
        role="region"
        aria-label={label}
        style={height === undefined ? undefined : { height: typeof height === "number" ? `${height}px` : height }}
    >
        <slot />
    </div>
    <button
        class="timeline-jump"
        type="button"
        data-timeline-oldest
        aria-label={end}
        title={end}
        aria-controls={id}
        hidden
    >↓</button>
</div>

<style>
    .timeline-window {
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--scroll-control-size);
        grid-template-rows: var(--scroll-control-size) auto var(--scroll-control-size);
        row-gap: var(--timeline-control-gap);
        margin-top: 1rem;
    }

    /* Keep layout coordinates independent of the animated items. */
    .timeline-scroll, .timeline-scroll > :global(ol) {
        position: relative;
    }

    .timeline-scroll {
        margin-inline-end: max(0px, calc((var(--scroll-control-size) - var(--timeline-scrollbar-width, 15px)) / 2));
        grid-column: 1 / -1;
        grid-row: 2;
        height: 35rem;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior-y: contain;
        scrollbar-gutter: stable;
    }

    .timeline-scroll:focus-visible {
        outline: none;
    }

    .timeline-scroll > :global(ol) {
        list-style: none;
        margin: 0;
        /* Reserve space for both the arc and the shared focus lift. */
        padding: 2rem calc(var(--timeline-arc-width, 2rem) + max(1.5rem, 8%)) 2rem 1rem;
    }

    .timeline-scroll :global(ol > li) {
        position: relative;
        transform-origin: left center;
        transform: translate(calc(var(--timeline-x, 0px) + var(--entrance-x, 0px)), var(--entrance-y, 0px)) scale(max(var(--item-focused, 0), var(--timeline-scale, 1)));
        opacity: calc(max(var(--item-focused, 0), var(--timeline-opacity, 1)) * var(--entrance-opacity, 1));
    }

    .timeline-scroll :global(ol > li:has(> time)) {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: max-content minmax(0, 1fr);
        gap: 0.5rem;
        padding-block: 0.5rem 1.5rem;
    }

    .timeline-scroll :global(ol > li > time) {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0;
        color: var(--muted);
        font: 0.75rem var(--mono);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .timeline-scroll :global(ol > li > time::before) {
        content: "";
        width: 5px;
        height: 5px;
        flex: none;
        background: var(--accent);
    }

    .timeline-jump {
        grid-column: 2;
    }

    [data-timeline-newest] { grid-row: 1; }
    [data-timeline-oldest] { grid-row: 3; }

    @media print {
        .timeline-jump { display: none; }
        .timeline-scroll {
            height: auto !important;
            overflow: visible;
        }
        .timeline-scroll :global(ol > li) { break-inside: avoid; }
    }

    @media (prefers-reduced-motion: reduce), print {
        .timeline-scroll :global(ol > li) {
            transform: none;
            opacity: 1;
        }
    }
</style>

<script>
    import { initializeTimelines } from "../../scripts/timeline";
    initializeTimelines();
</script>
