---
import { languages, type Locale } from "../../config/site";
import { collectionPageSize } from "../../config/collections";
import { useMessages } from "../../i18n/ui";

interface Props {
    locale: Locale;
    pageSize?: number;
}

const { locale, pageSize = collectionPageSize } = Astro.props;
const copy = useMessages(locale).pagination;
---

<nav
    class="pagination"
    aria-label={copy.label}
    data-pagination
    data-page-size={pageSize}
    data-format-locale={languages[locale].formatLocale}
    data-page-label={copy.page}
    data-status-label={copy.status}
    hidden
>
    <button type="button" data-page-control="first-page" hidden></button>
    <span data-page-gap="before" aria-hidden="true" hidden>...</span>
    <button type="button" data-page-control="previous" hidden></button>
    <button type="button" data-page-control="current" aria-current="page">1</button>
    <button type="button" data-page-control="next" hidden></button>
    <span data-page-gap="after" aria-hidden="true" hidden>...</span>
    <button type="button" data-page-control="last-page" hidden></button>
    <span class="sr-only" role="status" aria-live="polite" data-page-status></span>
</nav>

<script>
    import { initializePagination } from "../../scripts/pagination";
    initializePagination();
</script>
