---
import type { Locale } from "../../config/locales";
import { pageTurnInterval } from "../../config/collections";
import { useMessages } from "../../i18n/ui";

interface Props {
    id: string;
    label: string;
    locale: Locale;
    interval?: number;
}

const { id, label, locale, interval = pageTurnInterval } = Astro.props;
const copy = useMessages(locale).carousel;
---

<div class="page-turner carousel" data-page-turner data-interval={interval}>
    <header class="page-turner-header">
        <div class="page-turner-headings">
            <slot name="heading" />
        </div>
        <div class="carousel-controls page-turner-controls" data-page-turner-controls hidden>
            <button type="button" data-page-turner-previous aria-label={copy.previous} aria-controls={id}>←</button>
            <button type="button" data-page-turner-next aria-label={copy.next} aria-controls={id}>→</button>
            <span class="sr-only" data-page-turner-position role="status" aria-live="off" aria-atomic="true"></span>
        </div>
    </header>
    <div class="page-turner-pages" id={id} data-page-turner-pages role="region" aria-label={label}>
        <slot />
    </div>
</div>

<style>
    .page-turner {
        margin-top: 3.5rem;
    }

    .page-turner-pages {
        display: grid;
        perspective: 1800px;
        isolation: isolate;
    }

    .page-turner-pages > :global(*) {
        grid-area: 1 / 1;
        min-width: 0;
        margin-top: 0;
        visibility: hidden;
        background: var(--background);
        transform-origin: left center;
        backface-visibility: hidden;
    }

    .page-turner-pages > :global([data-current]),
    .page-turner-pages > :global([data-turning]) {
        visibility: visible;
    }

    .page-turner-pages > :global([data-current]) {
        z-index: 1;
    }

    .page-turner-pages > :global([data-turning]) {
        z-index: 2;
    }

    .page-turner-header {
        display: grid;
        align-items: center;
        padding-bottom: 0.9rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--line);
    }

    .page-turner-headings {
        grid-area: 1 / 1;
        display: grid;
        min-width: 0;
    }

    .page-turner-headings > :global(*) {
        grid-area: 1 / 1;
        visibility: hidden;
        display: grid;
        grid-template-columns: minmax(4.5rem, 1fr) minmax(0, auto) minmax(4.5rem, 1fr);
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
    }

    .page-turner-headings > :global([data-current]) {
        visibility: visible;
    }

    .page-turner-headings :global(h2) {
        grid-column: 1;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .page-turner-headings :global(.snapshot-notice) {
        grid-column: 2;
        margin-top: 0;
        min-width: 0;
        text-align: center;
        overflow-wrap: anywhere;
    }

    .page-turner-controls {
        grid-area: 1 / 1;
        justify-self: end;
        z-index: 1;
        display: flex;
        margin: 0;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    @media (max-width: 600px) {
        .page-turner {
            margin-top: 2rem;
        }

        .page-turner-headings > :global(*) {
            gap: 0.5rem;
        }

        .page-turner-headings :global(h2) {
            font-size: 1rem;
        }
    }

    @media print {
        .page-turner-pages {
            display: block;
        }

        .page-turner-pages > :global(*) {
            visibility: visible;
            transform: none !important;
        }

        .page-turner-headings > :global(*) {
            grid-area: auto;
            visibility: visible;
        }

        .page-turner-controls {
            display: none;
        }
    }
</style>

<script>
    import { initializePageTurners } from "../../scripts/page_turner";
    initializePageTurners();
</script>
