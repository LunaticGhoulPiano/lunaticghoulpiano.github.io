---
import SitePage from "../components/SitePage.astro";
import Post from "../components/blog/Post.astro";
import Tag from "../components/blog/Tag.astro";
import { getPageEntries } from "../routing";
import { getPublicPosts } from "../services/blog/index";

export async function getStaticPaths() {
    return getPageEntries(await getPublicPosts());
}

type Props = ReturnType<typeof getPageEntries>[number]["props"];
const props = Astro.props;
---

{props.kind === "page" && <SitePage route={props.route} locale={props.locale} />}
{props.kind === "post" && <Post post={props.post} />}
{props.kind === "tag" && <Tag tag={props.tag} locale={props.locale} />}
