---
import type { Locale } from "../config/site";
import { routes, type RouteKey } from "../config/routes";
import { getRoutePath } from "../routing";
import { useTranslations } from "../i18n/ui";

interface Props {
    locale: Locale;
    route: RouteKey;
    navigation: readonly RouteKey[];
}

const { locale, route, navigation } = Astro.props;
const t = useTranslations(locale);
---

<div class:list={["profile-layout", { "profile-published": route === "profile" }]}>
    {navigation.length > 0 && <nav class="profile-nav" aria-label={t("nav.profile")}>
        <ul>
            {navigation.map((item) => (
                <li>
                    <a href={getRoutePath(item, locale)} aria-current={route === item ? "page" : undefined}>
                        {item === "profile" ? t("common.overview") : t(routes[item].title)}
                    </a>
                </li>
            ))}
        </ul>
    </nav>}
    <div class="section-stack">
        <slot />
    </div>
</div>

<style>
    .profile-published {
        margin-top: 3rem;
        padding-block: var(--page-padding);
        border-top: 1px solid var(--chrome-line);
    }
</style>
