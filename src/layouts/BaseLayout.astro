---
import { themes, themeStyles } from "../config/theme";
import { languages, site, type Locale } from "../config/site";
import { type RouteKey } from "../config/routes";
import { getRoutePath } from "../routing";
import { useTranslations } from "../i18n/ui";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import SiteFooter from "../components/common/SiteFooter.astro";
import SiteNavigation from "../components/navigation/SiteNavigation.astro";
import themeScript from "../scripts/theme.js?raw";
import "../styles/global.css";

interface Props {
    article?: {
        date: string;
        updated?: string;
    };
    title: string;
    locale: Locale;
    description?: string;
    route?: RouteKey;
    noindex?: boolean;
    pagePath?: string;
    languagePaths?: Partial<Record<Locale, string>>;
}

const { title, locale, description, route, noindex = false, pagePath, languagePaths, article } = Astro.props;
const t = useTranslations(locale);
const pageTitle = route === "profile" ? site.name : `${title} | ${site.name}`;
const canonical =
    pagePath || route
        ? new URL(pagePath ?? getRoutePath(route!, locale), site.url).href
        : undefined;
const translations =
    languagePaths
    ?? (route
        ? Object.fromEntries(
            site.locales.map((language) => [language, getRoutePath(route, language)]),
        )
        : {});
---

<!doctype html>
<html lang={languages[locale].htmlLang} data-light-color={themes.light.background} data-dark-color={themes.dark.background}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark light" />
        <meta name="theme-color" content={themes.light.background} />
        <style is:inline set:html={themeStyles} />
        <script is:inline set:html={themeScript} />
        <title>{pageTitle}</title>
        {description && <meta name="description" content={description} />}
        {noindex && <meta name="robots" content="noindex, follow" />}
        {canonical && <link rel="canonical" href={canonical} />}
        {site.locales.filter((language) => translations[language]).map((language) => (
            <link
                rel="alternate"
                hreflang={languages[language].htmlLang}
                href={new URL(translations[language]!, site.url).href}
            />
        ))}
        {translations[site.defaultLocale] && (
            <link
                rel="alternate"
                hreflang="x-default"
                href={new URL(translations[site.defaultLocale]!, site.url).href}
            />
        )}
        <meta property="og:type" content={article ? "article" : "website"} />
        {article && <meta property="article:published_time" content={article.date} />}
        {article?.updated && <meta property="article:modified_time" content={article.updated} />}
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={pageTitle} />
        {description && <meta property="og:description" content={description} />}
        {canonical && <meta property="og:url" content={canonical} />}
    </head>
    <body class:list={{ "cv-page": route === "cv" }}>
        <a class="skip-link" href="#main-content">{t("nav.skip")}</a>
        <SiteHeader locale={locale} route={route} languagePaths={translations} />
        <div class="container site-frame">
            <aside class="site-rail">
                <SiteNavigation locale={locale} route={route} />
            </aside>
            <main class="main-content" id="main-content" tabindex="-1">
                <slot />
            </main>
        </div>
        <SiteFooter locale={locale} />
    </body>
</html>
